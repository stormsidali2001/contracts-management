{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "lint": "oxlint .",
    "test:e2e": "playwright test",
    "test:e2e:mock": "playwright test --project=mock",
