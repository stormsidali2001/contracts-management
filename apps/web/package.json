    "@mui/material": "^7.3.9",
    "@mui/material-nextjs": "^7.3.9",
    "@mui/x-data-grid": "^8.27.5",
    "@mui/x-date-pickers": "^8.27.2",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@types/jwt-decode": "^3.1.0",
    "apexcharts": "^3.35.5",
    "axios": "^0.27.2",
